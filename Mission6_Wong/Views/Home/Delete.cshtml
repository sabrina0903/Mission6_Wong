
@model Mission07_Wong.Models.Movie

<h2 class="text-center mb-4">Delete Movie</h2>

<div class="alert alert-warning text-center">
    <strong>Warning!</strong> Are you sure you want to delete this movie?
</div>

<div class="text-center mb-4">
    <h4>@Model.Title (@Model.Year)</h4>
    <p>Category: @Model.Category?.CategoryName</p>
</div>

<form asp-action="Delete" method="post" class="text-center">
    <input type="hidden" name="id" value="@Model.MovieId" /> <!-- must match parameter name in controller -->
    <button type="submit" class="btn btn-danger btn-lg">Delete</button>
    <a asp-action="Index" class="btn btn-secondary btn-lg">Cancel</a> <!-- redirect to Index -->
</form>
