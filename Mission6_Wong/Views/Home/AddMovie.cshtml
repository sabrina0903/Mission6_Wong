@model Mission07_Wong.Models.Movie

@{
    ViewData["Title"] = "Add Movie";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold mb-4">Add a Movie</h1>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">
            @ViewBag.Message
        </div>
    }

    <form asp-action="AddMovie" method="post" class="mx-auto" style="max-width: 500px;">
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Year" class="form-label"></label>
            <input asp-for="Year" type="number" class="form-control" />
            <span asp-validation-for="Year" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Edited" class="form-label"></label>
            <select asp-for="Edited" class="form-select">
                <option value="">--Select--</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
            <span asp-validation-for="Edited" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CopiedToPlex" class="form-label"></label>
            <select asp-for="CopiedToPlex" class="form-select">
                <option value="">--Select--</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
            <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Categories</label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">--Select Category--</option>
                @foreach (Category c in ViewBag.categories)
                {
                    <option value="@c.CategoryId">@c.CategoryName</option>
                }
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100">Add Movie</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
