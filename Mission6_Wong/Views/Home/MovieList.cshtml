@model List<Mission07_Wong.Models.Movie>

<div class="container mt-5">

    <h2 class="text-center mb-4">Movie Collection</h2>

    @{
        var message = TempData["Message"] as string;
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-success text-center w-50 mx-auto">
            @message
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered shadow text-center mx-auto">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Year</th>
                    <th>Edited</th>
                    <th>Copied to Plex</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="align-middle">
                @foreach (var movie in Model)
                {
                    <tr>
                        <td>@movie.Title</td>
                        <td>@movie.Year</td>
                        <td>@(movie.Edited ? "Yes" : "No")</td>
                        <td>@(movie.CopiedToPlex ? "Yes" : "No")</td>
                        <td>@movie.Category?.CategoryName</td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@movie.MovieId"
                               class="btn btn-warning btn-sm me-1">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@movie.MovieId"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
